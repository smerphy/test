# Agent abuse patterns — starter hardening bundle
#
# Targets common ways an agent (or an attacker who has prompt-injected
# one) misuses a tool call. Drop this in alongside your framework
# bundle; each rule is cross-tagged to the applicable framework
# controls so compliance reports still light up.
#
# Limitations:
#   - Predicates match by dotted path. Tool argument shapes vary across
#     tool kits (`body` vs `content` vs `payload` vs `text`), so most
#     rules check several common names via `or` clauses. Add your own
#     paths in a downstream bundle for tools that use other names.
#   - Regex-based PII detection has false positives. The rules favor
#     `require_approval` over `deny` where false positives are likely,
#     so a human always gets the final call.

policies:
  # ------------------------------------------------------------
  # 1. Credential exfil
  # ------------------------------------------------------------

  - id: abuse-deny-private-key-material
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----'}
        - {op: matches, path: tool.arguments.content, pattern: '-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----'}
        - {op: matches, path: tool.arguments.payload, pattern: '-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----'}
        - {op: matches, path: tool.arguments.text, pattern: '-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----'}
    reason: private key material in tool arguments is treated as exfil
    metadata:
      nist_ai_rmf: MEASURE-2.7
      iso_42001: A.8.4
      eu_ai_act: Article-15

  - id: abuse-approve-aws-access-key-in-args
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\b(?:AKIA|ASIA)[0-9A-Z]{16}\b'}
        - {op: matches, path: tool.arguments.url, pattern: '\b(?:AKIA|ASIA)[0-9A-Z]{16}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\b(?:AKIA|ASIA)[0-9A-Z]{16}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\b(?:AKIA|ASIA)[0-9A-Z]{16}\b'}
    reason: AWS access key id detected in outbound tool args — human must confirm
    metadata:
      nist_ai_rmf: MEASURE-2.7
      eu_ai_act: Article-15

  - id: abuse-approve-github-pat-in-args
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\bgh[pousr]_[A-Za-z0-9]{36}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\bgh[pousr]_[A-Za-z0-9]{36}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\bgh[pousr]_[A-Za-z0-9]{36}\b'}
    reason: GitHub personal access token pattern in tool args — human must confirm
    metadata:
      nist_ai_rmf: MEASURE-2.7
      eu_ai_act: Article-15

  - id: abuse-approve-slack-token-in-args
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\bxox[abprs]-[A-Za-z0-9-]{10,}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\bxox[abprs]-[A-Za-z0-9-]{10,}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\bxox[abprs]-[A-Za-z0-9-]{10,}\b'}
    reason: Slack token pattern in tool args — human must confirm
    metadata:
      nist_ai_rmf: MEASURE-2.7

  # ------------------------------------------------------------
  # 2. Credential-bearing URL parameters (transform → redact)
  # ------------------------------------------------------------

  - id: abuse-redact-credential-query-params
    effect: transform
    when:
      op: matches
      path: tool.arguments.url
      pattern: '(?i)[?&](?:api[_-]?key|access[_-]?token|auth|password|pwd|client[_-]?secret|bearer)='
    reason: redact credential-shaped query parameters before egress
    transform:
      url: '<praetor-redacted-credential-bearing-url>'
    metadata:
      nist_ai_rmf: MEASURE-2.7
      eu_ai_act: Article-15

  - id: abuse-redact-basic-auth-in-url
    effect: transform
    when:
      op: matches
      path: tool.arguments.url
      pattern: '://[^/@\s]+:[^@\s]+@'
    reason: strip basic-auth credentials embedded in the URL
    transform:
      url: '<praetor-stripped-basic-auth>'
    metadata:
      nist_ai_rmf: MEASURE-2.7
      eu_ai_act: Article-15

  # ------------------------------------------------------------
  # 3. SSRF / private network egress
  # ------------------------------------------------------------

  - id: abuse-deny-cloud-metadata-endpoints
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '(?:169\.254\.169\.254|metadata\.google\.internal|metadata\.aws\.amazon\.com)'
    reason: cloud metadata endpoint access from an agent is treated as SSRF
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.8.4
      eu_ai_act: Article-15

  - id: abuse-deny-rfc1918-private-networks
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '://(?:10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3})'
    reason: agents must not reach RFC 1918 private network ranges
    metadata:
      nist_ai_rmf: GOVERN-1.2
      eu_ai_act: Article-15

  - id: abuse-deny-localhost-egress
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '://(?:localhost|127\.0\.0\.1|\[::1\])'
    reason: agents must not reach localhost (likely SSRF or misconfiguration)
    metadata:
      nist_ai_rmf: GOVERN-1.2

  - id: abuse-deny-link-local
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '://(?:169\.254\.|\[fe80:)'
    reason: agents must not reach link-local addresses
    metadata:
      nist_ai_rmf: GOVERN-1.2

  - id: abuse-deny-dangerous-url-schemes
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '^(?:file|gopher|ftp|jar|dict|sftp):'
    reason: only http/https schemes are permitted for outbound tool calls
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.8.4

  # ------------------------------------------------------------
  # 4. PII egress
  # ------------------------------------------------------------

  - id: abuse-deny-ssn-in-tool-args
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\b\d{3}-\d{2}-\d{4}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\b\d{3}-\d{2}-\d{4}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\b\d{3}-\d{2}-\d{4}\b'}
        - {op: matches, path: tool.arguments.payload, pattern: '\b\d{3}-\d{2}-\d{4}\b'}
    reason: SSN-shaped value in outbound tool args — blocked as PII leak
    metadata:
      nist_ai_rmf: GOVERN-1.1
      iso_42001: A.5.2
      eu_ai_act: Article-15

  - id: abuse-redact-credit-card-pan
    effect: transform
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\b(?:4\d{12}(?:\d{3})?|5[1-5]\d{14}|3[47]\d{13}|6(?:011|5\d{2})\d{12})\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\b(?:4\d{12}(?:\d{3})?|5[1-5]\d{14}|3[47]\d{13}|6(?:011|5\d{2})\d{12})\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\b(?:4\d{12}(?:\d{3})?|5[1-5]\d{14}|3[47]\d{13}|6(?:011|5\d{2})\d{12})\b'}
    reason: PAN-shaped value (Visa/MC/Amex/Discover) — redact before egress
    transform:
      body: '<praetor-redacted-pan>'
      content: '<praetor-redacted-pan>'
      text: '<praetor-redacted-pan>'
    metadata:
      nist_ai_rmf: GOVERN-1.1
      eu_ai_act: Article-15

  # ------------------------------------------------------------
  # 5. Production infrastructure mutation
  # ------------------------------------------------------------

  - id: abuse-deny-iam-policy-mutation
    effect: deny
    when:
      op: matches
      path: tool.name
      pattern: '(?i)iam.*(?:put|update|attach|create|delete).*(?:policy|role)'
    reason: agents must not mutate IAM policies or roles
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.5.2

  - id: abuse-deny-destructive-db-on-prod
    effect: deny
    when:
      op: and
      clauses:
        - {op: eq, path: context.environment, value: production}
        - op: or
          clauses:
            - {op: matches, path: tool.arguments.sql, pattern: '(?i)\bDROP\s+(?:TABLE|DATABASE|SCHEMA|INDEX)\b'}
            - {op: matches, path: tool.arguments.sql, pattern: '(?i)\bTRUNCATE\s+TABLE\b'}
            - {op: matches, path: tool.arguments.query, pattern: '(?i)\bDROP\s+(?:TABLE|DATABASE|SCHEMA|INDEX)\b'}
            - {op: matches, path: tool.arguments.query, pattern: '(?i)\bTRUNCATE\s+TABLE\b'}
    reason: destructive DB statements are forbidden in production
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.5.2

  - id: abuse-approve-delete-without-where
    effect: require_approval
    when:
      op: and
      clauses:
        - op: or
          clauses:
            - {op: matches, path: tool.arguments.sql, pattern: '(?i)\bDELETE\s+FROM\b'}
            - {op: matches, path: tool.arguments.query, pattern: '(?i)\bDELETE\s+FROM\b'}
        - op: not
          clause:
            op: or
            clauses:
              - {op: matches, path: tool.arguments.sql, pattern: '(?i)\bWHERE\b'}
              - {op: matches, path: tool.arguments.query, pattern: '(?i)\bWHERE\b'}
    reason: DELETE without WHERE is almost never intended — human must confirm
    metadata:
      nist_ai_rmf: MANAGE-2.1

  # ------------------------------------------------------------
  # 6. Audit / observability tampering
  # ------------------------------------------------------------

  - id: abuse-deny-cloudtrail-tampering
    effect: deny
    when:
      op: matches
      path: tool.name
      pattern: '(?i)cloudtrail.*(?:delete|stop|update)|s3.*(?:delete_bucket_logging|put_bucket_logging)'
    reason: agents must not modify or disable CloudTrail / S3 access logging
    metadata:
      iso_42001: A.8.4
      eu_ai_act: Article-16

  - id: abuse-deny-log-group-deletion
    effect: deny
    when:
      op: matches
      path: tool.name
      pattern: '(?i)log[s_-]?group[s_-]?(?:delete|destroy)|delete[_-]?log[_-]?group'
    reason: agents must not delete log groups
    metadata:
      iso_42001: A.8.4
      eu_ai_act: Article-16

  - id: abuse-deny-praetor-self-tampering
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.name, pattern: '(?i)praetor.*(?:disable|delete|stop|bypass)'}
        - {op: matches, path: tool.arguments.path, pattern: 'audit\.jsonl$'}
        - {op: matches, path: tool.arguments.file_path, pattern: 'audit\.jsonl$'}
    reason: agents must not tamper with Praetor's own audit log or controls
    metadata:
      iso_42001: A.8.4
      eu_ai_act: Article-16
