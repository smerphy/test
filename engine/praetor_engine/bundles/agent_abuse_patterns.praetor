# Agent abuse patterns — starter hardening bundle
#
# Targets common ways an agent (or an attacker who has prompt-injected
# one) misuses a tool call. Drop this in alongside your framework
# bundle; each rule is cross-tagged to the applicable framework
# controls so compliance reports still light up.
#
# Limitations:
#   - Predicates match by dotted path. Tool argument shapes vary across
#     tool kits (`body` vs `content` vs `payload` vs `text`), so most
#     rules check several common names via `or` clauses. Add your own
#     paths in a downstream bundle for tools that use other names.
#   - Regex-based PII detection has false positives. The rules favor
#     `require_approval` over `deny` where false positives are likely,
#     so a human always gets the final call.

policies:
  # ------------------------------------------------------------
  # 1. Credential exfil
  # ------------------------------------------------------------

  - id: abuse-deny-private-key-material
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----'}
        - {op: matches, path: tool.arguments.content, pattern: '-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----'}
        - {op: matches, path: tool.arguments.payload, pattern: '-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----'}
        - {op: matches, path: tool.arguments.text, pattern: '-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----'}
    reason: private key material in tool arguments is treated as exfil
    metadata:
      nist_ai_rmf: MEASURE-2.7
      iso_42001: A.8.4
      eu_ai_act: Article-15

  - id: abuse-approve-aws-access-key-in-args
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\b(?:AKIA|ASIA)[0-9A-Z]{16}\b'}
        - {op: matches, path: tool.arguments.url, pattern: '\b(?:AKIA|ASIA)[0-9A-Z]{16}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\b(?:AKIA|ASIA)[0-9A-Z]{16}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\b(?:AKIA|ASIA)[0-9A-Z]{16}\b'}
    reason: AWS access key id detected in outbound tool args — human must confirm
    metadata:
      nist_ai_rmf: MEASURE-2.7
      eu_ai_act: Article-15

  - id: abuse-approve-github-pat-in-args
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\bgh[pousr]_[A-Za-z0-9]{36}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\bgh[pousr]_[A-Za-z0-9]{36}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\bgh[pousr]_[A-Za-z0-9]{36}\b'}
    reason: GitHub personal access token pattern in tool args — human must confirm
    metadata:
      nist_ai_rmf: MEASURE-2.7
      eu_ai_act: Article-15

  - id: abuse-approve-slack-token-in-args
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\bxox[abprs]-[A-Za-z0-9-]{10,}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\bxox[abprs]-[A-Za-z0-9-]{10,}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\bxox[abprs]-[A-Za-z0-9-]{10,}\b'}
    reason: Slack token pattern in tool args — human must confirm
    metadata:
      nist_ai_rmf: MEASURE-2.7

  # ------------------------------------------------------------
  # 2. Credential-bearing URL parameters (transform → redact)
  # ------------------------------------------------------------

  - id: abuse-redact-credential-query-params
    effect: transform
    when:
      op: matches
      path: tool.arguments.url
      pattern: '(?i)[?&](?:api[_-]?key|access[_-]?token|auth|password|pwd|client[_-]?secret|bearer)='
    reason: redact credential-shaped query parameters before egress
    transform:
      url: '<praetor-redacted-credential-bearing-url>'
    metadata:
      nist_ai_rmf: MEASURE-2.7
      eu_ai_act: Article-15

  - id: abuse-redact-basic-auth-in-url
    effect: transform
    when:
      op: matches
      path: tool.arguments.url
      pattern: '://[^/@\s]+:[^@\s]+@'
    reason: strip basic-auth credentials embedded in the URL
    transform:
      url: '<praetor-stripped-basic-auth>'
    metadata:
      nist_ai_rmf: MEASURE-2.7
      eu_ai_act: Article-15

  # ------------------------------------------------------------
  # 3. SSRF / private network egress
  # ------------------------------------------------------------

  - id: abuse-deny-cloud-metadata-endpoints
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '(?:169\.254\.169\.254|metadata\.google\.internal|metadata\.aws\.amazon\.com)'
    reason: cloud metadata endpoint access from an agent is treated as SSRF
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.8.4
      eu_ai_act: Article-15

  - id: abuse-deny-rfc1918-private-networks
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '://(?:10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3})'
    reason: agents must not reach RFC 1918 private network ranges
    metadata:
      nist_ai_rmf: GOVERN-1.2
      eu_ai_act: Article-15

  - id: abuse-deny-localhost-egress
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '://(?:localhost|127\.0\.0\.1|\[::1\])'
    reason: agents must not reach localhost (likely SSRF or misconfiguration)
    metadata:
      nist_ai_rmf: GOVERN-1.2

  - id: abuse-deny-link-local
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '://(?:169\.254\.|\[fe80:)'
    reason: agents must not reach link-local addresses
    metadata:
      nist_ai_rmf: GOVERN-1.2

  - id: abuse-deny-dangerous-url-schemes
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '^(?:file|gopher|ftp|jar|dict|sftp):'
    reason: only http/https schemes are permitted for outbound tool calls
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.8.4

  # ------------------------------------------------------------
  # 4. PII egress
  # ------------------------------------------------------------

  - id: abuse-deny-ssn-in-tool-args
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\b\d{3}-\d{2}-\d{4}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\b\d{3}-\d{2}-\d{4}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\b\d{3}-\d{2}-\d{4}\b'}
        - {op: matches, path: tool.arguments.payload, pattern: '\b\d{3}-\d{2}-\d{4}\b'}
    reason: SSN-shaped value in outbound tool args — blocked as PII leak
    metadata:
      nist_ai_rmf: GOVERN-1.1
      iso_42001: A.5.2
      eu_ai_act: Article-15

  - id: abuse-redact-credit-card-pan
    effect: transform
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\b(?:4\d{12}(?:\d{3})?|5[1-5]\d{14}|3[47]\d{13}|6(?:011|5\d{2})\d{12})\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\b(?:4\d{12}(?:\d{3})?|5[1-5]\d{14}|3[47]\d{13}|6(?:011|5\d{2})\d{12})\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\b(?:4\d{12}(?:\d{3})?|5[1-5]\d{14}|3[47]\d{13}|6(?:011|5\d{2})\d{12})\b'}
    reason: PAN-shaped value (Visa/MC/Amex/Discover) — redact before egress
    transform:
      body: '<praetor-redacted-pan>'
      content: '<praetor-redacted-pan>'
      text: '<praetor-redacted-pan>'
    metadata:
      nist_ai_rmf: GOVERN-1.1
      eu_ai_act: Article-15

  # ------------------------------------------------------------
  # 5. Production infrastructure mutation
  # ------------------------------------------------------------

  - id: abuse-deny-iam-policy-mutation
    effect: deny
    when:
      op: matches
      path: tool.name
      pattern: '(?i)iam.*(?:put|update|attach|create|delete).*(?:policy|role)'
    reason: agents must not mutate IAM policies or roles
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.5.2

  - id: abuse-deny-destructive-db-on-prod
    effect: deny
    when:
      op: and
      clauses:
        - {op: eq, path: context.environment, value: production}
        - op: or
          clauses:
            - {op: matches, path: tool.arguments.sql, pattern: '(?i)\bDROP\s+(?:TABLE|DATABASE|SCHEMA|INDEX)\b'}
            - {op: matches, path: tool.arguments.sql, pattern: '(?i)\bTRUNCATE\s+TABLE\b'}
            - {op: matches, path: tool.arguments.query, pattern: '(?i)\bDROP\s+(?:TABLE|DATABASE|SCHEMA|INDEX)\b'}
            - {op: matches, path: tool.arguments.query, pattern: '(?i)\bTRUNCATE\s+TABLE\b'}
    reason: destructive DB statements are forbidden in production
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.5.2

  - id: abuse-approve-delete-without-where
    effect: require_approval
    when:
      op: and
      clauses:
        - op: or
          clauses:
            - {op: matches, path: tool.arguments.sql, pattern: '(?i)\bDELETE\s+FROM\b'}
            - {op: matches, path: tool.arguments.query, pattern: '(?i)\bDELETE\s+FROM\b'}
        - op: not
          clause:
            op: or
            clauses:
              - {op: matches, path: tool.arguments.sql, pattern: '(?i)\bWHERE\b'}
              - {op: matches, path: tool.arguments.query, pattern: '(?i)\bWHERE\b'}
    reason: DELETE without WHERE is almost never intended — human must confirm
    metadata:
      nist_ai_rmf: MANAGE-2.1

  # ------------------------------------------------------------
  # 6. Audit / observability tampering
  # ------------------------------------------------------------

  - id: abuse-deny-cloudtrail-tampering
    effect: deny
    when:
      op: matches
      path: tool.name
      pattern: '(?i)cloudtrail.*(?:delete|stop|update)|s3.*(?:delete_bucket_logging|put_bucket_logging)'
    reason: agents must not modify or disable CloudTrail / S3 access logging
    metadata:
      iso_42001: A.8.4
      eu_ai_act: Article-16

  - id: abuse-deny-log-group-deletion
    effect: deny
    when:
      op: matches
      path: tool.name
      pattern: '(?i)log[s_-]?group[s_-]?(?:delete|destroy)|delete[_-]?log[_-]?group'
    reason: agents must not delete log groups
    metadata:
      iso_42001: A.8.4
      eu_ai_act: Article-16

  - id: abuse-deny-praetor-self-tampering
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.name, pattern: '(?i)praetor.*(?:disable|delete|stop|bypass)'}
        - {op: matches, path: tool.arguments.path, pattern: 'audit\.jsonl$'}
        - {op: matches, path: tool.arguments.file_path, pattern: 'audit\.jsonl$'}
    reason: agents must not tamper with Praetor's own audit log or controls
    metadata:
      iso_42001: A.8.4
      eu_ai_act: Article-16

  # ------------------------------------------------------------
  # 7. More credential / API-key patterns
  # ------------------------------------------------------------

  - id: abuse-approve-openai-anthropic-key
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}\b'}
        - {op: matches, path: tool.arguments.url, pattern: '\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}\b'}
    reason: OpenAI / Anthropic API key pattern in tool args — human must confirm
    metadata:
      nist_ai_rmf: MEASURE-2.7
      eu_ai_act: Article-15

  - id: abuse-approve-stripe-key
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\b(?:sk|pk|rk)_(?:live|test)_[A-Za-z0-9]{20,}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\b(?:sk|pk|rk)_(?:live|test)_[A-Za-z0-9]{20,}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\b(?:sk|pk|rk)_(?:live|test)_[A-Za-z0-9]{20,}\b'}
    reason: Stripe API key pattern in tool args — human must confirm
    metadata:
      nist_ai_rmf: MEASURE-2.7

  - id: abuse-approve-google-api-key
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\bAIza[0-9A-Za-z_-]{35}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\bAIza[0-9A-Za-z_-]{35}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\bAIza[0-9A-Za-z_-]{35}\b'}
        - {op: matches, path: tool.arguments.url, pattern: '\bAIza[0-9A-Za-z_-]{35}\b'}
    reason: Google API key pattern in tool args — human must confirm
    metadata:
      nist_ai_rmf: MEASURE-2.7

  - id: abuse-approve-huggingface-token
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\bhf_[A-Za-z0-9]{30,}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\bhf_[A-Za-z0-9]{30,}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\bhf_[A-Za-z0-9]{30,}\b'}
    reason: HuggingFace token pattern in tool args — human must confirm
    metadata:
      nist_ai_rmf: MEASURE-2.7

  - id: abuse-approve-npm-token
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\bnpm_[A-Za-z0-9]{30,}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\bnpm_[A-Za-z0-9]{30,}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\bnpm_[A-Za-z0-9]{30,}\b'}
    reason: npm token pattern in tool args — human must confirm
    metadata:
      nist_ai_rmf: MEASURE-2.7

  - id: abuse-approve-jwt-token
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b'}
        - {op: matches, path: tool.arguments.content, pattern: '\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b'}
        - {op: matches, path: tool.arguments.text, pattern: '\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b'}
    reason: JWT-shaped token in outbound tool args — human must confirm
    metadata:
      nist_ai_rmf: MEASURE-2.7
      eu_ai_act: Article-15

  # ------------------------------------------------------------
  # 8. Shell injection / RCE patterns
  # ------------------------------------------------------------

  - id: abuse-deny-reverse-shell-patterns
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.command, pattern: '(?i)(?:\bbash\s+-i\b|/dev/tcp/|\bnc\s+(?:-[a-z]*e[a-z]*)\b|\bncat\s+.*--exec\b|\bsocat\s+.*EXEC:)'}
        - {op: matches, path: tool.arguments.cmd, pattern: '(?i)(?:\bbash\s+-i\b|/dev/tcp/|\bnc\s+(?:-[a-z]*e[a-z]*)\b|\bncat\s+.*--exec\b|\bsocat\s+.*EXEC:)'}
        - {op: matches, path: tool.arguments.script, pattern: '(?i)(?:\bbash\s+-i\b|/dev/tcp/|\bnc\s+(?:-[a-z]*e[a-z]*)\b|\bncat\s+.*--exec\b|\bsocat\s+.*EXEC:)'}
        - {op: matches, path: tool.arguments.code, pattern: '(?i)(?:\bbash\s+-i\b|/dev/tcp/|\bnc\s+(?:-[a-z]*e[a-z]*)\b|\bncat\s+.*--exec\b|\bsocat\s+.*EXEC:)'}
    reason: reverse-shell signature in tool args
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.8.4

  - id: abuse-deny-curl-pipe-shell
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.command, pattern: '(?i)\b(?:curl|wget)\s+[^|;&]+\|\s*(?:sh|bash|zsh|python\d?|perl|ruby)\b'}
        - {op: matches, path: tool.arguments.cmd, pattern: '(?i)\b(?:curl|wget)\s+[^|;&]+\|\s*(?:sh|bash|zsh|python\d?|perl|ruby)\b'}
        - {op: matches, path: tool.arguments.script, pattern: '(?i)\b(?:curl|wget)\s+[^|;&]+\|\s*(?:sh|bash|zsh|python\d?|perl|ruby)\b'}
    reason: piping remote content into a shell is a classic RCE pattern
    metadata:
      nist_ai_rmf: MANAGE-2.1

  # ------------------------------------------------------------
  # 9. Path traversal & sensitive filesystem reads
  # ------------------------------------------------------------

  - id: abuse-deny-path-traversal
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.path, pattern: '\.\./|\.\.\\'}
        - {op: matches, path: tool.arguments.file_path, pattern: '\.\./|\.\.\\'}
        - {op: matches, path: tool.arguments.filename, pattern: '\.\./|\.\.\\'}
    reason: path-traversal sequence in a filesystem tool argument
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.8.4

  - id: abuse-deny-sensitive-path-read
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.path, pattern: '(?:/etc/(?:passwd|shadow|sudoers|hosts)\b|/root/|/\.ssh/|/proc/(?:self/environ|\d+/cmdline)|/var/run/docker\.sock)'}
        - {op: matches, path: tool.arguments.file_path, pattern: '(?:/etc/(?:passwd|shadow|sudoers|hosts)\b|/root/|/\.ssh/|/proc/(?:self/environ|\d+/cmdline)|/var/run/docker\.sock)'}
        - {op: matches, path: tool.arguments.filename, pattern: '(?:/etc/(?:passwd|shadow|sudoers|hosts)\b|/root/|/\.ssh/|/proc/(?:self/environ|\d+/cmdline)|/var/run/docker\.sock)'}
    reason: agents must not read sensitive system paths
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.8.4

  # ------------------------------------------------------------
  # 10. Webhook / known exfil destinations
  # ------------------------------------------------------------

  - id: abuse-deny-known-exfil-webhooks
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '(?:discord\.com/api/webhooks/|hooks\.slack\.com/services/|api\.telegram\.org/bot|webhook\.site/)'
    reason: outbound to a known webhook receiver — likely exfil channel
    metadata:
      nist_ai_rmf: MEASURE-2.7
      eu_ai_act: Article-15

  - id: abuse-deny-pastebin-exfil
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '(?:pastebin\.com|paste\.bin|hastebin\.com|ghostbin\.com|transfer\.sh|file\.io|anonfiles\.com|tmpfiles\.org|0x0\.st|controlc\.com|paste\.ee|rentry\.co)'
    reason: outbound to a public paste / file-share service — exfil risk
    metadata:
      nist_ai_rmf: MEASURE-2.7
      eu_ai_act: Article-15

  - id: abuse-deny-tor-onion
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '\.onion(?:[/:]|$)'
    reason: agents must not reach .onion addresses
    metadata:
      nist_ai_rmf: GOVERN-1.2
      eu_ai_act: Article-15

  # ------------------------------------------------------------
  # 11. Container / Kubernetes destructive operations
  # ------------------------------------------------------------

  - id: abuse-deny-k8s-destructive
    effect: deny
    when:
      op: matches
      path: tool.name
      pattern: '(?i)(?:kubectl[._-](?:delete|drain|cordon|exec)|helm[._-]uninstall|kubectl[._-]scale.*--replicas=0)'
    reason: agents must not run destructive Kubernetes operations
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.5.2

  - id: abuse-deny-docker-privileged
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.command, pattern: '(?:--privileged|--cap-add=SYS_ADMIN|--pid=host|--net=host|--ipc=host|-v\s+/:/host)'}
        - {op: matches, path: tool.arguments.cmd, pattern: '(?:--privileged|--cap-add=SYS_ADMIN|--pid=host|--net=host|--ipc=host|-v\s+/:/host)'}
        - {op: matches, path: tool.arguments.run_args, pattern: '(?:--privileged|--cap-add=SYS_ADMIN|--pid=host|--net=host|--ipc=host|-v\s+/:/host)'}
    reason: agents must not launch privileged or host-namespaced containers
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.5.2

  # ------------------------------------------------------------
  # 12. Permission escalation
  # ------------------------------------------------------------

  - id: abuse-deny-privilege-escalation
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.name, pattern: '(?i)^sudo|^setuid|setfacl'}
        - {op: matches, path: tool.arguments.command, pattern: '(?i)(?:\bchmod\s+(?:[0-7]?[4-7][0-7]{2}|\+s\b|u\+s\b)|\busermod\b.*-aG\s+(?:sudo|wheel|admin)|/etc/sudoers|gpasswd\s+-a)'}
        - {op: matches, path: tool.arguments.cmd, pattern: '(?i)(?:\bchmod\s+(?:[0-7]?[4-7][0-7]{2}|\+s\b|u\+s\b)|\busermod\b.*-aG\s+(?:sudo|wheel|admin)|/etc/sudoers|gpasswd\s+-a)'}
        - {op: matches, path: tool.arguments.script, pattern: '(?i)(?:\bchmod\s+(?:[0-7]?[4-7][0-7]{2}|\+s\b|u\+s\b)|\busermod\b.*-aG\s+(?:sudo|wheel|admin)|/etc/sudoers|gpasswd\s+-a)'}
    reason: privilege-escalation primitive in a tool call
    metadata:
      nist_ai_rmf: MANAGE-2.1
      iso_42001: A.5.2

  # ------------------------------------------------------------
  # 13. Crypto wallet addresses (possible laundering / theft)
  # ------------------------------------------------------------

  - id: abuse-approve-crypto-wallet-in-args
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.body, pattern: '(?:\bbc1[a-zA-HJ-NP-Z0-9]{25,87}\b|\b[13][a-km-zA-HJ-NP-Z1-9]{25,34}\b|\b0x[a-fA-F0-9]{40}\b)'}
        - {op: matches, path: tool.arguments.content, pattern: '(?:\bbc1[a-zA-HJ-NP-Z0-9]{25,87}\b|\b[13][a-km-zA-HJ-NP-Z1-9]{25,34}\b|\b0x[a-fA-F0-9]{40}\b)'}
