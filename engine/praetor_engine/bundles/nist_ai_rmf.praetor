# NIST AI Risk Management Framework (AI RMF 1.0) — Starter Bundle
#
# Maps a representative subset of GOVERN, MAP, MEASURE, and MANAGE
# function controls to runtime policy enforcement. Customize the
# allowlists / denylists for your tenant, then extend.
#
# Reference: https://nvlpubs.nist.gov/nistpubs/ai/NIST.AI.100-1.pdf
policies:
  # GOVERN-1.1: Legal and regulatory requirements involving AI are understood,
  # managed, and documented. We require approval for any tool that processes
  # PII so that humans verify the legal basis on a case-by-case basis.
  - id: govern-1-1-approve-pii-processors
    effect: require_approval
    when:
      op: or
      clauses:
        - {op: matches, path: tool.name, pattern: '(?i)pii|personal|identifier'}
        - {op: matches, path: tool.arguments.url, pattern: '/users/|/customers/'}
    reason: PII-handling tools require recorded human approval (NIST AI RMF GOVERN-1.1)
    metadata:
      nist_ai_rmf: GOVERN-1.1

  # MANAGE-2.1: Resources required to manage AI risks are deployed.
  # Block any tool that would mutate production infrastructure without an
  # explicit per-org allowlist override.
  - id: manage-2-1-block-prod-infra-writes
    effect: deny
    when:
      op: and
      clauses:
        - {op: in, path: tool.name, values: [terraform.apply, kubectl.apply, helm.upgrade]}
        - {op: eq, path: context.environment, value: production}
    reason: agents may not mutate production infrastructure (NIST AI RMF MANAGE-2.1)
    metadata:
      nist_ai_rmf: MANAGE-2.1

  # MEASURE-2.7: AI system security and resilience are evaluated.
  # Redact secrets from outbound HTTP arguments before they leave the agent.
  - id: measure-2-7-redact-secrets-in-urls
    effect: transform
    when:
      op: matches
      path: tool.arguments.url
      pattern: '(?:token|api_key|secret|password)='
    reason: redact secret query parameters before egress (NIST AI RMF MEASURE-2.7)
    transform:
      url: '<redacted-by-praetor>'
    metadata:
      nist_ai_rmf: MEASURE-2.7

  # GOVERN-1.2: Policies, processes, procedures, and practices across the
  # organization related to mapping, measuring, and managing AI risks are
  # in place and follow international standards.
  - id: govern-1-2-deny-internal-hostnames
    effect: deny
    when:
      op: matches
      path: tool.arguments.url
      pattern: '\.internal(?:$|/|:)'
    reason: agents must not reach internal hostnames (NIST AI RMF GOVERN-1.2)
    metadata:
      nist_ai_rmf: GOVERN-1.2
