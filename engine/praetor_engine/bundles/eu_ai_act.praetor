# EU AI Act — Starter Bundle (focused on Article 14: Human Oversight)
#
# Article 14 requires that high-risk AI systems be designed for effective
# human oversight, including the ability to intervene. Praetor's
# require_approval + audit-log + transform effects map directly.
policies:
  # Article 14(4)(a) — the natural person to whom oversight is assigned
  # must be able to fully understand the capabilities and limitations of
  # the high-risk AI system. We pause for approval on any tool that
  # invokes the high-risk subset.
  - id: eu-ai-act-14-4a-pause-high-risk-tools
    effect: require_approval
    when:
      op: in
      path: tool.name
      values:
        - credit.decision
        - hiring.score
        - medical.recommend
        - law_enforcement.search
    reason: high-risk tool calls require recorded human oversight (EU AI Act Art. 14(4)(a))
    metadata:
      eu_ai_act: Article-14(4)(a)

  # Article 14(4)(d) — the ability to override the decision (intervene)
  # is provided. Deny any tool that the model attempts to call with a
  # 'force=true' or 'override_human=true' flag.
  - id: eu-ai-act-14-4d-block-human-override-flag
    effect: deny
    when:
      op: or
      clauses:
        - {op: eq, path: tool.arguments.force, value: true}
        - {op: eq, path: tool.arguments.override_human, value: true}
    reason: agents may not invoke tools with explicit human-override flags (EU AI Act Art. 14(4)(d))
    metadata:
      eu_ai_act: Article-14(4)(d)

  # Article 15 — Accuracy, robustness and cybersecurity.
  # Redact any URL-bound credentials before the tool call leaves the agent.
  - id: eu-ai-act-15-redact-credentials
    effect: transform
    when:
      op: matches
      path: tool.arguments.url
      pattern: '://[^/@]+:[^@]+@'  # basic-auth-in-URL
    reason: strip in-URL credentials before egress (EU AI Act Art. 15)
    transform:
      url: '<basic-auth-redacted>'
    metadata:
      eu_ai_act: Article-15

  # Article 16 — Obligations on providers: maintain logs.
  # Block any tool that would purge or modify the audit trail.
  - id: eu-ai-act-16-block-audit-tampering
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.name, pattern: '(?i)audit.*(delete|purge|truncate)'}
        - {op: matches, path: tool.name, pattern: '(?i)log.*delete'}
    reason: agents may not tamper with the audit trail (EU AI Act Art. 16)
    metadata:
      eu_ai_act: Article-16
