# Prompt-injection & jailbreak detection — starter bundle
#
# Scans the common text-bearing tool-argument fields for prompt-
# injection, jailbreak, instruction-override, indirect-injection and
# data-exfil patterns (OWASP LLM01/LLM02/LLM06). Clear manipulation
# attempts are denied; ambiguous signals (extraction attempts,
# encoded blobs, zero-width text) require human approval to bound
# false positives. Combine with your framework bundle.
#
# Scanned paths: tool.arguments.prompt, tool.arguments.message, tool.arguments.content, tool.arguments.text, tool.arguments.input, tool.arguments.body, tool.arguments.query
# Patterns are linear-time (bounded gaps/classes, no nested
# unbounded quantifiers) so the bundle is not itself a ReDoS vector.

policies:
  - id: pi-deny-instruction-override
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.prompt, pattern: '(?i)\b(?:ignore|disregard|forget|discard)\b[^.\n]{0,40}\b(?:previous|prior|earlier|above|preceding|initial|original|all\s+prior)\b[^.\n]{0,20}\b(?:instruction|prompt|message|direction|rule|command|context|guideline)s?\b'}
        - {op: matches, path: tool.arguments.message, pattern: '(?i)\b(?:ignore|disregard|forget|discard)\b[^.\n]{0,40}\b(?:previous|prior|earlier|above|preceding|initial|original|all\s+prior)\b[^.\n]{0,20}\b(?:instruction|prompt|message|direction|rule|command|context|guideline)s?\b'}
        - {op: matches, path: tool.arguments.content, pattern: '(?i)\b(?:ignore|disregard|forget|discard)\b[^.\n]{0,40}\b(?:previous|prior|earlier|above|preceding|initial|original|all\s+prior)\b[^.\n]{0,20}\b(?:instruction|prompt|message|direction|rule|command|context|guideline)s?\b'}
        - {op: matches, path: tool.arguments.text, pattern: '(?i)\b(?:ignore|disregard|forget|discard)\b[^.\n]{0,40}\b(?:previous|prior|earlier|above|preceding|initial|original|all\s+prior)\b[^.\n]{0,20}\b(?:instruction|prompt|message|direction|rule|command|context|guideline)s?\b'}
        - {op: matches, path: tool.arguments.input, pattern: '(?i)\b(?:ignore|disregard|forget|discard)\b[^.\n]{0,40}\b(?:previous|prior|earlier|above|preceding|initial|original|all\s+prior)\b[^.\n]{0,20}\b(?:instruction|prompt|message|direction|rule|command|context|guideline)s?\b'}
        - {op: matches, path: tool.arguments.body, pattern: '(?i)\b(?:ignore|disregard|forget|discard)\b[^.\n]{0,40}\b(?:previous|prior|earlier|above|preceding|initial|original|all\s+prior)\b[^.\n]{0,20}\b(?:instruction|prompt|message|direction|rule|command|context|guideline)s?\b'}
        - {op: matches, path: tool.arguments.query, pattern: '(?i)\b(?:ignore|disregard|forget|discard)\b[^.\n]{0,40}\b(?:previous|prior|earlier|above|preceding|initial|original|all\s+prior)\b[^.\n]{0,20}\b(?:instruction|prompt|message|direction|rule|command|context|guideline)s?\b'}
    reason: 'prompt-injection: attempt to ignore/override prior instructions'
    metadata:
      owasp_llm: LLM01
      nist_ai_rmf: MEASURE-2.7
      eu_ai_act: Article-15

  - id: pi-deny-directive-override
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.prompt, pattern: '(?i)\b(?:override|overrule|bypass|circumvent|disable|turn\s+off|switch\s+off|remove)\b[^.\n]{0,30}\b(?:instruction|guideline|rule|system\s+prompt|programming|directive|safety|content\s+filter|filter|restriction|guardrail|policy|policies)s?\b'}
        - {op: matches, path: tool.arguments.message, pattern: '(?i)\b(?:override|overrule|bypass|circumvent|disable|turn\s+off|switch\s+off|remove)\b[^.\n]{0,30}\b(?:instruction|guideline|rule|system\s+prompt|programming|directive|safety|content\s+filter|filter|restriction|guardrail|policy|policies)s?\b'}
        - {op: matches, path: tool.arguments.content, pattern: '(?i)\b(?:override|overrule|bypass|circumvent|disable|turn\s+off|switch\s+off|remove)\b[^.\n]{0,30}\b(?:instruction|guideline|rule|system\s+prompt|programming|directive|safety|content\s+filter|filter|restriction|guardrail|policy|policies)s?\b'}
        - {op: matches, path: tool.arguments.text, pattern: '(?i)\b(?:override|overrule|bypass|circumvent|disable|turn\s+off|switch\s+off|remove)\b[^.\n]{0,30}\b(?:instruction|guideline|rule|system\s+prompt|programming|directive|safety|content\s+filter|filter|restriction|guardrail|policy|policies)s?\b'}
        - {op: matches, path: tool.arguments.input, pattern: '(?i)\b(?:override|overrule|bypass|circumvent|disable|turn\s+off|switch\s+off|remove)\b[^.\n]{0,30}\b(?:instruction|guideline|rule|system\s+prompt|programming|directive|safety|content\s+filter|filter|restriction|guardrail|policy|policies)s?\b'}
        - {op: matches, path: tool.arguments.body, pattern: '(?i)\b(?:override|overrule|bypass|circumvent|disable|turn\s+off|switch\s+off|remove)\b[^.\n]{0,30}\b(?:instruction|guideline|rule|system\s+prompt|programming|directive|safety|content\s+filter|filter|restriction|guardrail|policy|policies)s?\b'}
        - {op: matches, path: tool.arguments.query, pattern: '(?i)\b(?:override|overrule|bypass|circumvent|disable|turn\s+off|switch\s+off|remove)\b[^.\n]{0,30}\b(?:instruction|guideline|rule|system\s+prompt|programming|directive|safety|content\s+filter|filter|restriction|guardrail|policy|policies)s?\b'}
    reason: 'prompt-injection: attempt to override/disable guidelines or safety'
    metadata:
      owasp_llm: LLM01
      nist_ai_rmf: MANAGE-2.1
      eu_ai_act: Article-15

  - id: pi-deny-jailbreak-persona
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.prompt, pattern: '(?i)\b(?:do\s+anything\s+now|jailbreak|jailbroken|developer\s+mode|god\s+mode|sudo\s+mode|unrestricted\s+mode|kernel\s+mode|dev\s+mode\s+enabled)\b'}
        - {op: matches, path: tool.arguments.message, pattern: '(?i)\b(?:do\s+anything\s+now|jailbreak|jailbroken|developer\s+mode|god\s+mode|sudo\s+mode|unrestricted\s+mode|kernel\s+mode|dev\s+mode\s+enabled)\b'}
        - {op: matches, path: tool.arguments.content, pattern: '(?i)\b(?:do\s+anything\s+now|jailbreak|jailbroken|developer\s+mode|god\s+mode|sudo\s+mode|unrestricted\s+mode|kernel\s+mode|dev\s+mode\s+enabled)\b'}
        - {op: matches, path: tool.arguments.text, pattern: '(?i)\b(?:do\s+anything\s+now|jailbreak|jailbroken|developer\s+mode|god\s+mode|sudo\s+mode|unrestricted\s+mode|kernel\s+mode|dev\s+mode\s+enabled)\b'}
        - {op: matches, path: tool.arguments.input, pattern: '(?i)\b(?:do\s+anything\s+now|jailbreak|jailbroken|developer\s+mode|god\s+mode|sudo\s+mode|unrestricted\s+mode|kernel\s+mode|dev\s+mode\s+enabled)\b'}
        - {op: matches, path: tool.arguments.body, pattern: '(?i)\b(?:do\s+anything\s+now|jailbreak|jailbroken|developer\s+mode|god\s+mode|sudo\s+mode|unrestricted\s+mode|kernel\s+mode|dev\s+mode\s+enabled)\b'}
        - {op: matches, path: tool.arguments.query, pattern: '(?i)\b(?:do\s+anything\s+now|jailbreak|jailbroken|developer\s+mode|god\s+mode|sudo\s+mode|unrestricted\s+mode|kernel\s+mode|dev\s+mode\s+enabled)\b'}
        - {op: matches, path: tool.arguments.prompt, pattern: '(?i)\byou\s+are\s+(?:now\s+)?(?:in\s+)?(?:DAN|STAN|AIM|an?\s+(?:unrestricted|unfiltered|uncensored|jailbroken|amoral|rogue|evil))\b'}
        - {op: matches, path: tool.arguments.message, pattern: '(?i)\byou\s+are\s+(?:now\s+)?(?:in\s+)?(?:DAN|STAN|AIM|an?\s+(?:unrestricted|unfiltered|uncensored|jailbroken|amoral|rogue|evil))\b'}
        - {op: matches, path: tool.arguments.content, pattern: '(?i)\byou\s+are\s+(?:now\s+)?(?:in\s+)?(?:DAN|STAN|AIM|an?\s+(?:unrestricted|unfiltered|uncensored|jailbroken|amoral|rogue|evil))\b'}
        - {op: matches, path: tool.arguments.text, pattern: '(?i)\byou\s+are\s+(?:now\s+)?(?:in\s+)?(?:DAN|STAN|AIM|an?\s+(?:unrestricted|unfiltered|uncensored|jailbroken|amoral|rogue|evil))\b'}
        - {op: matches, path: tool.arguments.input, pattern: '(?i)\byou\s+are\s+(?:now\s+)?(?:in\s+)?(?:DAN|STAN|AIM|an?\s+(?:unrestricted|unfiltered|uncensored|jailbroken|amoral|rogue|evil))\b'}
        - {op: matches, path: tool.arguments.body, pattern: '(?i)\byou\s+are\s+(?:now\s+)?(?:in\s+)?(?:DAN|STAN|AIM|an?\s+(?:unrestricted|unfiltered|uncensored|jailbroken|amoral|rogue|evil))\b'}
        - {op: matches, path: tool.arguments.query, pattern: '(?i)\byou\s+are\s+(?:now\s+)?(?:in\s+)?(?:DAN|STAN|AIM|an?\s+(?:unrestricted|unfiltered|uncensored|jailbroken|amoral|rogue|evil))\b'}
    reason: 'prompt-injection: known jailbreak persona / mode-switch'
    metadata:
      owasp_llm: LLM01
      nist_ai_rmf: MANAGE-2.1

  - id: pi-deny-roleplay-escape
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.prompt, pattern: '(?i)\b(?:pretend|imagine|roleplay|role-play|act\s+as|behave\s+as|simulate\s+being|you\s+are\s+playing)\b[^.\n]{0,45}\b(?:unrestricted|unfiltered|uncensored|amoral|evil|no\s+(?:restrictions|rules|limits|filters|ethics)|without\s+(?:restrictions|rules|limits|guidelines|filters|ethics|morals))\b'}
        - {op: matches, path: tool.arguments.message, pattern: '(?i)\b(?:pretend|imagine|roleplay|role-play|act\s+as|behave\s+as|simulate\s+being|you\s+are\s+playing)\b[^.\n]{0,45}\b(?:unrestricted|unfiltered|uncensored|amoral|evil|no\s+(?:restrictions|rules|limits|filters|ethics)|without\s+(?:restrictions|rules|limits|guidelines|filters|ethics|morals))\b'}
        - {op: matches, path: tool.arguments.content, pattern: '(?i)\b(?:pretend|imagine|roleplay|role-play|act\s+as|behave\s+as|simulate\s+being|you\s+are\s+playing)\b[^.\n]{0,45}\b(?:unrestricted|unfiltered|uncensored|amoral|evil|no\s+(?:restrictions|rules|limits|filters|ethics)|without\s+(?:restrictions|rules|limits|guidelines|filters|ethics|morals))\b'}
        - {op: matches, path: tool.arguments.text, pattern: '(?i)\b(?:pretend|imagine|roleplay|role-play|act\s+as|behave\s+as|simulate\s+being|you\s+are\s+playing)\b[^.\n]{0,45}\b(?:unrestricted|unfiltered|uncensored|amoral|evil|no\s+(?:restrictions|rules|limits|filters|ethics)|without\s+(?:restrictions|rules|limits|guidelines|filters|ethics|morals))\b'}
        - {op: matches, path: tool.arguments.input, pattern: '(?i)\b(?:pretend|imagine|roleplay|role-play|act\s+as|behave\s+as|simulate\s+being|you\s+are\s+playing)\b[^.\n]{0,45}\b(?:unrestricted|unfiltered|uncensored|amoral|evil|no\s+(?:restrictions|rules|limits|filters|ethics)|without\s+(?:restrictions|rules|limits|guidelines|filters|ethics|morals))\b'}
        - {op: matches, path: tool.arguments.body, pattern: '(?i)\b(?:pretend|imagine|roleplay|role-play|act\s+as|behave\s+as|simulate\s+being|you\s+are\s+playing)\b[^.\n]{0,45}\b(?:unrestricted|unfiltered|uncensored|amoral|evil|no\s+(?:restrictions|rules|limits|filters|ethics)|without\s+(?:restrictions|rules|limits|guidelines|filters|ethics|morals))\b'}
        - {op: matches, path: tool.arguments.query, pattern: '(?i)\b(?:pretend|imagine|roleplay|role-play|act\s+as|behave\s+as|simulate\s+being|you\s+are\s+playing)\b[^.\n]{0,45}\b(?:unrestricted|unfiltered|uncensored|amoral|evil|no\s+(?:restrictions|rules|limits|filters|ethics)|without\s+(?:restrictions|rules|limits|guidelines|filters|ethics|morals))\b'}
    reason: 'prompt-injection: roleplay/pretend used to escape restrictions'
    metadata:
      owasp_llm: LLM01

  - id: pi-deny-safety-suppression
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.prompt, pattern: '(?i)\b(?:without|no\s+need\s+for|skip|omit|suppress)\b[^.\n]{0,20}\b(?:warning|disclaimer|caveat|refusal|ethical|moral|safety)s?\b'}
        - {op: matches, path: tool.arguments.message, pattern: '(?i)\b(?:without|no\s+need\s+for|skip|omit|suppress)\b[^.\n]{0,20}\b(?:warning|disclaimer|caveat|refusal|ethical|moral|safety)s?\b'}
        - {op: matches, path: tool.arguments.content, pattern: '(?i)\b(?:without|no\s+need\s+for|skip|omit|suppress)\b[^.\n]{0,20}\b(?:warning|disclaimer|caveat|refusal|ethical|moral|safety)s?\b'}
        - {op: matches, path: tool.arguments.text, pattern: '(?i)\b(?:without|no\s+need\s+for|skip|omit|suppress)\b[^.\n]{0,20}\b(?:warning|disclaimer|caveat|refusal|ethical|moral|safety)s?\b'}
        - {op: matches, path: tool.arguments.input, pattern: '(?i)\b(?:without|no\s+need\s+for|skip|omit|suppress)\b[^.\n]{0,20}\b(?:warning|disclaimer|caveat|refusal|ethical|moral|safety)s?\b'}
        - {op: matches, path: tool.arguments.body, pattern: '(?i)\b(?:without|no\s+need\s+for|skip|omit|suppress)\b[^.\n]{0,20}\b(?:warning|disclaimer|caveat|refusal|ethical|moral|safety)s?\b'}
        - {op: matches, path: tool.arguments.query, pattern: '(?i)\b(?:without|no\s+need\s+for|skip|omit|suppress)\b[^.\n]{0,20}\b(?:warning|disclaimer|caveat|refusal|ethical|moral|safety)s?\b'}
        - {op: matches, path: tool.arguments.prompt, pattern: '(?i)\b(?:do\s+not|don''''t|never|stop)\b[^.\n]{0,20}\b(?:refuse|warn|apolog(?:ize|ise)|caution|lecture|moraliz(?:e|ing)|add\s+(?:a\s+)?(?:warning|disclaimer))\b'}
        - {op: matches, path: tool.arguments.message, pattern: '(?i)\b(?:do\s+not|don''''t|never|stop)\b[^.\n]{0,20}\b(?:refuse|warn|apolog(?:ize|ise)|caution|lecture|moraliz(?:e|ing)|add\s+(?:a\s+)?(?:warning|disclaimer))\b'}
        - {op: matches, path: tool.arguments.content, pattern: '(?i)\b(?:do\s+not|don''''t|never|stop)\b[^.\n]{0,20}\b(?:refuse|warn|apolog(?:ize|ise)|caution|lecture|moraliz(?:e|ing)|add\s+(?:a\s+)?(?:warning|disclaimer))\b'}
        - {op: matches, path: tool.arguments.text, pattern: '(?i)\b(?:do\s+not|don''''t|never|stop)\b[^.\n]{0,20}\b(?:refuse|warn|apolog(?:ize|ise)|caution|lecture|moraliz(?:e|ing)|add\s+(?:a\s+)?(?:warning|disclaimer))\b'}
        - {op: matches, path: tool.arguments.input, pattern: '(?i)\b(?:do\s+not|don''''t|never|stop)\b[^.\n]{0,20}\b(?:refuse|warn|apolog(?:ize|ise)|caution|lecture|moraliz(?:e|ing)|add\s+(?:a\s+)?(?:warning|disclaimer))\b'}
        - {op: matches, path: tool.arguments.body, pattern: '(?i)\b(?:do\s+not|don''''t|never|stop)\b[^.\n]{0,20}\b(?:refuse|warn|apolog(?:ize|ise)|caution|lecture|moraliz(?:e|ing)|add\s+(?:a\s+)?(?:warning|disclaimer))\b'}
        - {op: matches, path: tool.arguments.query, pattern: '(?i)\b(?:do\s+not|don''''t|never|stop)\b[^.\n]{0,20}\b(?:refuse|warn|apolog(?:ize|ise)|caution|lecture|moraliz(?:e|ing)|add\s+(?:a\s+)?(?:warning|disclaimer))\b'}
    reason: 'prompt-injection: instruction to suppress warnings/refusals'
    metadata:
      owasp_llm: LLM01

  - id: pi-deny-injection-control-tokens
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.prompt, pattern: '(?:<\|(?:im_start|im_end|im_sep|endoftext|system|user|assistant|eot_id|start_header_id|end_header_id|begin_of_text)\|>|\[/?INST\]|<</?SYS>>)'}
        - {op: matches, path: tool.arguments.message, pattern: '(?:<\|(?:im_start|im_end|im_sep|endoftext|system|user|assistant|eot_id|start_header_id|end_header_id|begin_of_text)\|>|\[/?INST\]|<</?SYS>>)'}
        - {op: matches, path: tool.arguments.content, pattern: '(?:<\|(?:im_start|im_end|im_sep|endoftext|system|user|assistant|eot_id|start_header_id|end_header_id|begin_of_text)\|>|\[/?INST\]|<</?SYS>>)'}
        - {op: matches, path: tool.arguments.text, pattern: '(?:<\|(?:im_start|im_end|im_sep|endoftext|system|user|assistant|eot_id|start_header_id|end_header_id|begin_of_text)\|>|\[/?INST\]|<</?SYS>>)'}
        - {op: matches, path: tool.arguments.input, pattern: '(?:<\|(?:im_start|im_end|im_sep|endoftext|system|user|assistant|eot_id|start_header_id|end_header_id|begin_of_text)\|>|\[/?INST\]|<</?SYS>>)'}
        - {op: matches, path: tool.arguments.body, pattern: '(?:<\|(?:im_start|im_end|im_sep|endoftext|system|user|assistant|eot_id|start_header_id|end_header_id|begin_of_text)\|>|\[/?INST\]|<</?SYS>>)'}
        - {op: matches, path: tool.arguments.query, pattern: '(?:<\|(?:im_start|im_end|im_sep|endoftext|system|user|assistant|eot_id|start_header_id|end_header_id|begin_of_text)\|>|\[/?INST\]|<</?SYS>>)'}
    reason: 'prompt-injection: chat/instruction control tokens embedded in arguments'
    metadata:
      owasp_llm: LLM01

  - id: pi-deny-instruction-preamble
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.prompt, pattern: '(?i)\b(?:new|updated|revised|real|actual|true|secret|hidden)\s+(?:instruction|directive|task|objective|prompt|system\s+prompt|rule)s?\s*:'}
        - {op: matches, path: tool.arguments.message, pattern: '(?i)\b(?:new|updated|revised|real|actual|true|secret|hidden)\s+(?:instruction|directive|task|objective|prompt|system\s+prompt|rule)s?\s*:'}
        - {op: matches, path: tool.arguments.content, pattern: '(?i)\b(?:new|updated|revised|real|actual|true|secret|hidden)\s+(?:instruction|directive|task|objective|prompt|system\s+prompt|rule)s?\s*:'}
        - {op: matches, path: tool.arguments.text, pattern: '(?i)\b(?:new|updated|revised|real|actual|true|secret|hidden)\s+(?:instruction|directive|task|objective|prompt|system\s+prompt|rule)s?\s*:'}
        - {op: matches, path: tool.arguments.input, pattern: '(?i)\b(?:new|updated|revised|real|actual|true|secret|hidden)\s+(?:instruction|directive|task|objective|prompt|system\s+prompt|rule)s?\s*:'}
        - {op: matches, path: tool.arguments.body, pattern: '(?i)\b(?:new|updated|revised|real|actual|true|secret|hidden)\s+(?:instruction|directive|task|objective|prompt|system\s+prompt|rule)s?\s*:'}
        - {op: matches, path: tool.arguments.query, pattern: '(?i)\b(?:new|updated|revised|real|actual|true|secret|hidden)\s+(?:instruction|directive|task|objective|prompt|system\s+prompt|rule)s?\s*:'}
        - {op: matches, path: tool.arguments.prompt, pattern: '(?i)\bfrom\s+now\s+on\b[^.\n]{0,20}\byou\s+(?:will|must|are|should|shall|can)\b'}
        - {op: matches, path: tool.arguments.message, pattern: '(?i)\bfrom\s+now\s+on\b[^.\n]{0,20}\byou\s+(?:will|must|are|should|shall|can)\b'}
        - {op: matches, path: tool.arguments.content, pattern: '(?i)\bfrom\s+now\s+on\b[^.\n]{0,20}\byou\s+(?:will|must|are|should|shall|can)\b'}
        - {op: matches, path: tool.arguments.text, pattern: '(?i)\bfrom\s+now\s+on\b[^.\n]{0,20}\byou\s+(?:will|must|are|should|shall|can)\b'}
        - {op: matches, path: tool.arguments.input, pattern: '(?i)\bfrom\s+now\s+on\b[^.\n]{0,20}\byou\s+(?:will|must|are|should|shall|can)\b'}
        - {op: matches, path: tool.arguments.body, pattern: '(?i)\bfrom\s+now\s+on\b[^.\n]{0,20}\byou\s+(?:will|must|are|should|shall|can)\b'}
        - {op: matches, path: tool.arguments.query, pattern: '(?i)\bfrom\s+now\s+on\b[^.\n]{0,20}\byou\s+(?:will|must|are|should|shall|can)\b'}
    reason: 'prompt-injection: injected ''new instructions'' preamble / override cue'
    metadata:
      owasp_llm: LLM01

  - id: pi-deny-tool-redefinition
    effect: deny
    when:
      op: or
      clauses:
        - {op: matches, path: tool.arguments.prompt, pattern: '(?i)\byou\s+(?:now\s+)?(?:have|possess|are\s+granted|gained)\b[^.\n]{0,25}\b(?:new\s+)?(?:tool|function|capability|command|permission|ability|privilege)s?\b'}
        - {op: matches, path: tool.arguments.message, pattern: '(?i)\byou\s+(?:now\s+)?(?:have|possess|are\s+granted|gained)\b[^.\n]{0,25}\b(?:new\s+)?(?:tool|function|capability|command|permission|ability|privilege)s?\b'}
        - {op: matches, path: tool.arguments.content, pattern: '(?i)\byou\s+(?:now\s+)?(?:have|possess|are\s+granted|gained)\b[^.\n]{0,25}\b(?:new\s+)?(?:tool|function|capability|command|permission|ability|privilege)s?\b'}
        - {op: matches, path: tool.arguments.text, pattern: '(?i)\byou\s+(?:now\s+)?(?:have|possess|are\s+granted|gained)\b[^.\n]{0,25}\b(?:new\s+)?(?:tool|function|capability|command|permission|ability|privilege)s?\b'}
        - {op: matches, path: tool.arguments.input, pattern: '(?i)\byou\s+(?:now\s+)?(?:have|possess|are\s+granted|gained)\b[^.\n]{0,25}\b(?:new\s+)?(?:tool|function|capability|command|permission|ability|privilege)s?\b'}
        - {op: matches, path: tool.arguments.body, pattern: '(?i)\byou\s+(?:now\s+)?(?:have|possess|are\s+granted|gained)\b[^.\n]{0,25}\b(?:new\s+)?(?:tool|function|capability|command|permission|ability|privilege)s?\b'}
        - {op: matches, path: tool.arguments.query, pattern: '(?i)\byou\s+(?:now\s+)?(?:have|possess|are\s+granted|gained)\b[^.\n]{0,25}\b(?:new\s+)?(?:tool|function|capability|command|permission|ability|privilege)s?\b'}
        - {op: matches, path: tool.arguments.prompt, pattern: '(?i)\b(?:new|additional|hidden|secret)\b[^.\n]{0,15}\b(?:tool|function|capability|command|instruction)s?\b[^.\n]{0,15}\b(?:available|added|enabled|unlocked|activated|granted)\b'}
        - {op: matches, path: tool.arguments.message, pattern: '(?i)\b(?:new|additional|hidden|secret)\b[^.\n]{0,15}\b(?:tool|function|capability|command|instruction)s?\b[^.\n]{0,15}\b(?:available|added|enabled|unlocked|activated|granted)\b'}
        - {op: matches, path: tool.arguments.content, pattern: '(?i)\b(?:new|additional|hidden|secret)\b[^.\n]{0,15}\b(?:tool|function|capability|command|instruction)s?\b[^.\n]{0,15}\b(?:available|added|enabled|unlocked|activated|granted)\b'}
